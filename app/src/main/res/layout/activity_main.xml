<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ns1="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PTX7 PIMS Scanner v0.3" android:textSize="24sp" android:textStyle="bold" android:paddingBottom="8dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

        <Button android:id="@+id/textSizeButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="PIMS 90%" />
    </LinearLayout>

    <Button android:id="@+id/scannerCollapseButton" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:text="SHOW SCANNER" android:textSize="13sp" /><LinearLayout android:id="@+id/scannerSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><Button android:id="@+id/cameraToggleButton" android:layout_width="match_parent" android:layout_height="36dp" android:text="HIDE CAMERA" android:textSize="12sp" />

    <androidx.camera.view.PreviewView android:id="@+id/previewView" android:layout_width="match_parent" android:layout_height="90dp" ns1:implementationMode="performance" />

    <TextView android:id="@+id/debugText" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:text="Scanner debug information will appear here" android:textSize="14sp" android:paddingTop="8dp" android:paddingBottom="8dp" />

    <EditText android:id="@+id/pimsUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:text="https://console.inventory.pharmacy.amazon.dev/inventory?facility=PTX7" android:hint="PIMS URL" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

        <Button android:id="@+id/scanNowButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="SCAN NOW" />

        <CheckBox android:id="@+id/autoScan" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Auto scan" android:textSize="14sp" android:checked="false" />
    </LinearLayout>

    <TextView android:id="@+id/lastScan" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No scan yet" android:textSize="20sp" android:textStyle="bold" android:paddingTop="10dp" android:paddingBottom="10dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

        <Button android:id="@+id/copyButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Copy" />

        <Button android:id="@+id/openChromeButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Open PIMS" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

        <Button android:id="@+id/loadIntegratedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Integrated PIMS" />

        <Button android:id="@+id/sendToPageButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Send + Submit" />
    </LinearLayout>

    <CheckBox android:id="@+id/autoSubmit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="After scan, send to integrated PIMS and submit" android:checked="false" />

    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Requesting camera permission..." android:paddingBottom="6dp" />

    </LinearLayout><WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

</LinearLayout>