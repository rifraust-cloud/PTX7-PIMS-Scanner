<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:fitsSystemWindows="true"

    android:background="#F5F7F8">


    <!-- APP HEADER -->

    <LinearLayout

        android:id="@+id/appHeader"

        android:layout_width="match_parent"

        android:layout_height="52dp"

        android:orientation="horizontal"

        android:gravity="center_vertical"

        android:paddingStart="16dp"

        android:paddingEnd="8dp"

        android:background="#006D77">


        <TextView

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="PTX7 PIMS Scanner"

            android:textColor="#FFFFFF"

            android:textSize="20sp"

            android:textStyle="bold" />


        <Button

            android:id="@+id/fullscreenButton"

            android:layout_width="50dp"

            android:layout_height="40dp"

            android:text="⛶"

            android:textSize="20sp"

            android:textColor="#FFFFFF"

            android:backgroundTint="#006D77" />

    </LinearLayout>



    <!-- COLLAPSIBLE SCANNER BAR -->

    <Button

        android:id="@+id/scannerCollapseButton"

        android:layout_width="match_parent"

        android:layout_height="44dp"

        android:layout_marginStart="8dp"

        android:layout_marginEnd="8dp"

        android:layout_marginTop="6dp"

        android:layout_marginBottom="4dp"

        android:text="SCANNER  ▼"

        android:textStyle="bold"

        android:textSize="15sp"

        android:textColor="#173042"

        android:backgroundTint="#FFFFFF" />



    <!-- EXISTING SCANNER PANEL -->

    <LinearLayout

        android:id="@+id/scannerSection"

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="10dp"

        android:paddingEnd="10dp"

        android:paddingBottom="8dp"

        android:visibility="gone">


        <Button

            android:id="@+id/cameraToggleButton"

            android:layout_width="match_parent"

            android:layout_height="40dp"

            android:text="HIDE CAMERA"

            android:textSize="13sp" />


        <androidx.camera.view.PreviewView

            android:id="@+id/previewView"

            android:layout_width="match_parent"

            android:layout_height="110dp"

            app:implementationMode="performance" />


        <EditText

            android:id="@+id/pimsUrl"

            android:layout_width="match_parent"

            android:layout_height="44dp"

            android:singleLine="true"

            android:textSize="13sp"

            android:hint="PIMS URL"

            android:text="https://console.inventory.pharmacy.amazon.dev" />


        <LinearLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:gravity="center_vertical">


            <Button

                android:id="@+id/scanNowButton"

                android:layout_width="0dp"

                android:layout_height="44dp"

                android:layout_weight="1"

                android:text="SCAN NOW" />


            <CheckBox

                android:id="@+id/autoScan"

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="Auto scan"

                android:layout_marginStart="8dp" />

        </LinearLayout>


        <TextView

            android:id="@+id/lastScan"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:minHeight="40dp"

            android:gravity="center_vertical"

            android:text="No scan yet"

            android:textStyle="bold"

            android:textSize="19sp"

            android:textColor="#253645"

            android:paddingTop="5dp"

            android:paddingBottom="5dp" />


        <LinearLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:orientation="horizontal">


            <Button

                android:id="@+id/copyButton"

                android:layout_width="0dp"

                android:layout_height="44dp"

                android:layout_weight="1"

                android:layout_marginEnd="4dp"

                android:text="COPY" />


            <Button

                android:id="@+id/openChromeButton"

                android:layout_width="0dp"

                android:layout_height="44dp"

                android:layout_weight="1"

                android:layout_marginStart="4dp"

                android:text="OPEN PIMS" />

        </LinearLayout>


        <LinearLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:layout_marginTop="4dp">


            <Button

                android:id="@+id/loadIntegratedButton"

                android:layout_width="0dp"

                android:layout_height="44dp"

                android:layout_weight="1"

                android:layout_marginEnd="4dp"

                android:text="INTEGRATED PIMS" />


            <Button

                android:id="@+id/sendToPageButton"

                android:layout_width="0dp"

                android:layout_height="44dp"

                android:layout_weight="1"

                android:layout_marginStart="4dp"

                android:text="SEND + SUBMIT" />

        </LinearLayout>


        <CheckBox

            android:id="@+id/autoSubmit"

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="After scan, send to integrated PIMS and submit" />


        <TextView

            android:id="@+id/statusText"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:text="Ready"

            android:textSize="13sp"

            android:textColor="#666666"

            android:paddingTop="4dp"

            android:paddingBottom="4dp" />


        <TextView

            android:id="@+id/debugText"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:textSize="10sp"

            android:textColor="#777777"

            android:maxLines="4"

            android:visibility="gone" />

    </LinearLayout>



    <!-- PIMS HEADER -->

    <LinearLayout

        android:id="@+id/pimsHeader"

        android:layout_width="match_parent"

        android:layout_height="42dp"

        android:orientation="horizontal"

        android:gravity="center_vertical"

        android:paddingStart="12dp"

        android:paddingEnd="8dp"

        android:background="#FFFFFF">


        <TextView

            android:layout_width="0dp"

            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="PIM Console"

            android:textSize="17sp"

            android:textStyle="bold"

            android:textColor="#253645" />


        <Button

            android:id="@+id/textSizeButton"

            android:layout_width="64dp"

            android:layout_height="36dp"

            android:minWidth="0dp"

            android:minHeight="0dp"

            android:text="FIT"

            android:textSize="12sp" />

    </LinearLayout>



    <!--
        ZOOM TOOLBAR IS ABOVE THE WEBVIEW.

        Nothing in the Android app now covers the bottom of PIMS.
    -->

    <LinearLayout

        android:id="@+id/zoomToolbar"

        android:layout_width="match_parent"

        android:layout_height="44dp"

        android:orientation="horizontal"

        android:gravity="center"

        android:paddingStart="6dp"

        android:paddingEnd="6dp"

        android:background="#F3F5F6">


        <Button

            android:id="@+id/zoomOutButton"

            android:layout_width="52dp"

            android:layout_height="38dp"

            android:minWidth="0dp"

            android:minHeight="0dp"

            android:text="−"

            android:textSize="21sp" />


        <TextView

            android:id="@+id/zoomText"

            android:layout_width="62dp"

            android:layout_height="38dp"

            android:gravity="center"

            android:text="FIT"

            android:textStyle="bold"

            android:textSize="14sp"

            android:textColor="#006D77" />


        <Button

            android:id="@+id/zoomInButton"

            android:layout_width="52dp"

            android:layout_height="38dp"

            android:minWidth="0dp"

            android:minHeight="0dp"

            android:text="+"

            android:textSize="19sp" />


        <Button

            android:id="@+id/fitButton"

            android:layout_width="62dp"

            android:layout_height="38dp"

            android:minWidth="0dp"

            android:minHeight="0dp"

            android:layout_marginStart="5dp"

            android:text="FIT"

            android:textSize="12sp" />


        <Button

            android:id="@+id/centerButton"

            android:layout_width="82dp"

            android:layout_height="38dp"

            android:minWidth="0dp"

            android:minHeight="0dp"

            android:layout_marginStart="5dp"

            android:text="CENTER"

            android:textSize="10sp" />

    </LinearLayout>



    <!-- PIMS GETS ALL REMAINING HEIGHT -->

    <WebView

        android:id="@+id/webView"

        android:layout_width="match_parent"

        android:layout_height="0dp"

        android:layout_weight="1"

        android:background="#FFFFFF" />


</LinearLayout>
